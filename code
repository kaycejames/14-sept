P=$(find / -maxdepth 5 -type d -name "final-expense-app" 2>/dev/null | head -1); echo "=== project: $P"
echo "=== 1 commit"; git -C "$P" log -1 --oneline
echo "=== 2 local changes"; git -C "$P" status --short
echo "=== 3 env"; ls -la "$P/.env"; grep -E "^(HOST|PORT|FEA_DATA_DIR|DATA)" "$P/.env"
echo "=== 4 data folders"; find / -maxdepth 6 -type d \( -name "final-expense-data" -o -name "Final Expense Assistant" -o -name "final-expense-assistant" \) 2>/dev/null | while read d; do echo "$d"; ls -la "$d"; done
echo "=== 5 listening"; ss -ltn | grep 5180
echo "=== 6 health"; curl -s http://localhost:5180/api/health || echo "not answering"
echo "=== 7 how it starts"; systemctl list-units --type=service --all | grep -iE "final|expense|fea"; crontab -l 2>/dev/null; pm2 list 2>/dev/null
echo "=== 8 node"; node -v; npm -v
echo "=== 9 network"; ip -br addr; nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null
echo "=== 10 disk and memory"; df -h /; free -h
echo "=== 11 system"; lsb_release -d; lspci | grep -i vga


